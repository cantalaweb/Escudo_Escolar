# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# =============================================================================
# Copia este archivo a .env y rellena con tus credenciales reales

# PostgreSQL en Render.com
DATABASE_URL=postgresql://backend_app:TU_PASSWORD_AQUI@dpg-d4vg58fpm1nc73bo3qcg-a.frankfurt-postgres.render.com/escudo_escolar_db

# Alternativamente, puedes especificar cada componente por separado:
# DB_USER=backend_app
# DB_PASSWORD=tu_password
# DB_HOST=dpg-d4vg58fpm1nc73bo3qcg-a.frankfurt-postgres.render.com
# DB_PORT=5432
# DB_NAME=escudo_escolar_db

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================
# Para generar una clave secreta segura, ejecuta en Python:
# import secrets; print(secrets.token_urlsafe(32))

SECRET_KEY=tu_clave_secreta_para_jwt_aqui_cambiar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =============================================================================
APP_NAME=Escudo Escolar
APP_VERSION=2.0.0
DEBUG=True

# CORS - Orígenes permitidos (separados por comas)
# En desarrollo:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# En producción, usa tu dominio real:
# ALLOWED_ORIGINS=https://tu-dominio.com

# =============================================================================
# OPENAI API (para el chatbot)
# =============================================================================
OPENAI_API_KEY=tu_openai_api_key_aqui

# =============================================================================
# MACHINE LEARNING (modelo de predicción)
# =============================================================================
# Ruta al modelo XGBoost entrenado
# Puede ser ruta relativa (desde el directorio backend/) o absoluta
MODEL_PATH=./models/bullying_detection_model.json
# En producción, ajustar según la ubicación real:
# MODEL_PATH=/var/www/escudo-escolar/models/bullying_detection_model.json
