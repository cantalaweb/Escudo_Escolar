# =============================================================================
# CONFIGURACIÓN DOCKER - Escudo Escolar
# =============================================================================
# Copia este archivo a .env y configura tus valores

# =============================================================================
# BASE DE DATOS POSTGRESQL
# =============================================================================
POSTGRES_DB=escudo_escolar_db
POSTGRES_USER=backend_app
POSTGRES_PASSWORD=cambiar_password_seguro_aqui

# =============================================================================
# BACKEND
# =============================================================================
# Generar con: openssl rand -hex 32
SECRET_KEY=cambiar_clave_secreta_jwt_aqui

# OpenAI API Key (para chatbot)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Ruta al modelo ML (dentro del contenedor)
MODEL_PATH=/app/models/bullying_detection_model.json

# CORS - Dominios permitidos
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Debug mode
DEBUG=False

# =============================================================================
# FRONTEND
# =============================================================================
# URL del backend API
# Desarrollo: http://localhost:8000
# Producción con Nginx: http://tu-dominio.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000
